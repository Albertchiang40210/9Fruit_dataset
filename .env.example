# 複製為 .env 並填入實際值（.env 已被 .gitignore 排除，請勿上傳）
DB_HOST=fruit_db
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change_me
DB_DATABASE=fruit_store

FASTAPI_PORT=8000
YOLO_MODEL_PATH=result/train-5/weights/best.pt
